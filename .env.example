# Angular storefront — Hipermercado Superior
#
# NOTA: esta app Angular NO lee variables de entorno en tiempo de build
# (no usa process.env ni .env). Estas variables documentan la configuración
# de API del proyecto; los valores deben aplicarse a
# `src/app/core/api/api.config.ts` (`DEFAULT_API_BASE_URL` /
# `DEFAULT_STORAGE_PUBLIC_URL`) ANTES del build de producción.
#
# En desarrollo la app usa rutas RELATIVAS: '/api' (y '/uploads') proxieadas al
# backend local (http://localhost:3000) vía proxy.conf.json — sin cambios.

# Base del API REST. Desarrollo: '/api' (same-origin, proxieada). Producción:
# URL real del backend desplegado (requerida).
ANGULAR_API_BASE_URL=/api

# Base pública para resolver claves de imagen (uploads). Desarrollo: vacío
# (rutas relativas proxieadas). Producción: base pública del CDN/R2 (requerida).
ANGULAR_STORAGE_PUBLIC_URL=